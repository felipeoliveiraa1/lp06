---
// REMARKETING — copia da raiz (LP completa) SEM o gate: os 15 blocos e o
// botao aparecem desde o primeiro segundo. O resto (VSL, checkout, deteccao de
// variante do A/B, preco da oferta) e identico ao index.astro — se a raiz mudar,
// esta pagina precisa ser refeita a partir dela.
import Base from '../layouts/Base.astro';

// MESMO TESTE A/B DE PRECO da /aberta (vturb ab-test 6aac64bb…), 50/50:
//   A  6aac6243  "VSL PADRAO 297"  -> checkout c938339a (R$297)
//   B  6aac648f  "FRONT ANTIGO"    -> checkout 5ecd76ce (R$397)
// Mesma VSL, mesmos links e mesmo pitch (18:03 na linha do tempo do video) da /aberta.
// As duas variantes trazem a headline em imagem pelo vturb -> a da pagina fica oculta (.hl-page).
const CHECKOUT = 'https://checkout.payt.com.br/f/69f35d4779e8c7d3737711d4d5a6bac0?split=12'; // default (B) ate detectar
const A = '/assets/';
const img = {
  heroBg: A + 'hero-bg.webp',
  bgS2: A + '47cd5dd7a6ee45da_bg-s2_resultado12.webp',
  at: [
    A + '1fbcc6fe5a8dd418_IMG-AT-1_resultado1.webp',
    A + '036ac490246605f6_IMG-AT-2_resultado1-300x169.webp',
    A + '1c147d119736ff85_IMG-AT-3_resultado1.webp',
    A + 'eb2d974dbd294bee_IMG-AT-4_resultado1-300x169.webp',
    A + '890fd3dff2bdf27a_IMG-AT-5_resultado1.webp',
