  <!-- reveal A/B: o CTA aparece quando o VÍDEO chega em 18:03 (mesmo pitch nas duas variantes;
       tempo na LINHA DO TEMPO do video, nao no relogio: o player roda com turbo 1.2x).
       A variante vem do id REAL do player: o vturb reescreve <vturb-smartplayer id="ab-…">
       para "vid-<variante>" ao resolver o teste (fallback: localStorage vturb-ab-<testId>).
       Cada variante troca o href dos 3 CTAs [data-ck] e a linha de preço da oferta
       (A -> R$297 · B -> R$397). Chave própria da home: quem já assistiu a /aberta não entra liberado aqui.
       Fail-open se o player não carregar (adblock). ?preview revela na hora · ?debug mostra variante/tempo. -->
  <script is:inline>
    (function () {
      var AB_KEY = 'vturb-ab-6aac64bbdc15da46cd434f86';
      var VAR_A = '6aac6243cbca2ded7bfe7157', PITCH_A = 18 * 60 + 3; // A "VSL PADRAO 297": 18:03 = 1083s
      var VAR_B = '6aac648f76eb195e3e5f14fd', PITCH_B = 18 * 60 + 3; // B "FRONT ANTIGO":   18:03 = 1083s
      var CK_A = 'https://checkout.payt.com.br/f/69f35d4779e8c7d3737711d4d5a6bac0?split=12'; // R$297
      var CK_B = 'https://checkout.payt.com.br/f/69f35d4779e8c7d3737711d4d5a6bac0?split=12'; // R$397
      var PITCH = Math.max(PITCH_A, PITCH_B); // até detectar a variante, usa o maior (nunca revela cedo)
      var VARIANTE = 'detectando…', CK = '—', lastT = -1;
      var PRECO_A = '12X R$ 27,64<small>ou 297 à vista!</small>'; // valores do checkout c938339a
      var PRECO_B = '12X R$ 27,64<small>ou 297 à vista!</small>'; // mesmo da A: o checkout do front agora e unico (f/195c0eb1, R$297)
      var KEY = 'al_rmktfull_v1', t0 = Date.now(), saw = false, revealed = false;
      function mmss(s) { if (!(s >= 0)) return '--:--'; var m = Math.floor(s / 60), r = Math.floor(s % 60); return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r; }
      // Troca SO a base do checkout e preserva a query que ja estiver no href: o UTMify (Base.astro)
      // injeta utm_* nos links depois do load, e o tick roda pra sempre -- comparar/reescrever a URL
      // inteira apagava os UTMs a cada segundo (venda chegava no Payt sem atribuicao).
      function setCk(u, tag, preco) {
        var base = u.split('?')[0], as = document.querySelectorAll('a[data-ck]');
        for (var i = 0; i < as.length; i++) {
          var cur = as[i].getAttribute('href') || '';
          if (cur.split('?')[0] === base) continue;                       // ja e este checkout: nao toca
          var keep = [], q = cur.indexOf('?') > -1 ? cur.slice(cur.indexOf('?') + 1).split('&') : [];
          for (var k = 0; k < q.length; k++) { if (q[k] && q[k].indexOf('split=') !== 0) keep.push(q[k]); }
          as[i].setAttribute('href', u + (keep.length ? '&' + keep.join('&') : ''));   // u ja traz ?split=12
        }
        var p = document.getElementById('offer-price'); if (p && p.innerHTML !== preco) p.innerHTML = preco;
        CK = tag;
      }
      function detect() {
        var el = document.querySelector('vturb-smartplayer'), id = (el && el.id) ? el.id.replace(/^vid-/, '') : '';
        if (!id || id.indexOf('ab-') === 0) { try { id = localStorage.getItem(AB_KEY) || ''; } catch (e) { id = ''; } }
        if (id === VAR_A) { PITCH = PITCH_A; VARIANTE = 'A (297)'; setCk(CK_A, '195c0eb1 R$297', PRECO_A); }
        else if (id === VAR_B) { PITCH = PITCH_B; VARIANTE = 'B (297)'; setCk(CK_B, '195c0eb1 R$297', PRECO_B); }
      }
      function vtime() { try { var a = (window.smartplayer && window.smartplayer.instances) || []; for (var i = 0; i < a.length; i++) { var t = a[i] && a[i].instance && a[i].instance.currentTime; if (typeof t === 'number' && isFinite(t)) return t; } } catch (e) {} return -1; }
      function reveal() { revealed = true; document.documentElement.classList.remove('gated'); try { localStorage.setItem(KEY, '1'); } catch (e) {} }
      var dbg = null;
      if (/[?&]debug/.test(location.search)) {
        dbg = document.createElement('div');
        dbg.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:99999;background:rgba(0,0,0,.85);color:#1eff00;font:12px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;padding:9px 12px;border:1px solid #1eff00;border-radius:8px;pointer-events:none;white-space:pre';
        var put = function () { if (document.body && !dbg.parentNode) document.body.appendChild(dbg); };
        put(); document.addEventListener('DOMContentLoaded', put);
      }
      function paint() { if (dbg) dbg.textContent = 'variante: ' + VARIANTE + '\npitch:    ' + mmss(PITCH) + '\nvideo:    ' + mmss(lastT) + '\nfalta:    ' + (revealed ? 'liberado' : mmss(PITCH - lastT)) + '\ncheckout: ' + CK; }
      // O tick roda SEMPRE, inclusive depois de revelar: o href do CTA tem que seguir a variante
      // sorteada mesmo que o player só carregue depois do fail-open (rede lenta) ou numa volta.
      function tick() {
        detect();
        var t = vtime(); lastT = t;
        if (t >= 0) saw = true;
        if (!revealed) {
          if (t >= PITCH) reveal();
          else if (!saw && Date.now() - t0 > 30000) reveal(); // fail-open: player não carregou (adblock)
        }
        paint();
      }
      try { if (/[?&]preview/.test(location.search)) { revealed = true; document.documentElement.classList.remove('gated'); } } catch (e) {}
      try { if (!revealed && localStorage.getItem(KEY)) reveal(); } catch (e) {}
      tick();                    // 1ª rodada síncrona: href certo antes de qualquer clique
      setInterval(tick, 1000);
    })();
  </script>
