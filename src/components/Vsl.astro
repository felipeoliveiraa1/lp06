---
// VSL nativa do vturb: o player carrega no LOAD da página (o vturb conta a impressão
// = play-rate real). Sem facade/poster estático. O gate da página lê o tempo real do
// vídeo (window.smartplayer.instances[i].instance.currentTime) pra revelar o CTA.
// o id do ELEMENTO tem prefixo "vid-", mas a URL do player.js usa o id PURO.
const { playerId, account = 'd9544c5d-ba21-4c7b-aa65-b6663bf5494d' } = Astro.props;
const bareId = playerId.replace(/^vid-/, '');
const playerScript = `https://scripts.converteai.net/${account}/players/${bareId}/v4/player.js`;
---
<div class="vsl-slot" id="vsl">
  <vturb-smartplayer id={playerId} style="display:block;width:100%;height:100%"></vturb-smartplayer>
</div>
<script is:inline define:vars={{ playerScript }}>
  (function () { var s = document.createElement('script'); s.src = playerScript; s.async = true; document.head.appendChild(s); })();
</script>
